# Copy to .env and fill in. .env is gitignored and must never be committed.

# Groq API key, used for generation and for LLM-as-judge during evaluation.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_REASONING_EFFORT=low

# Other OpenAI-compatible providers. Leave a key blank to skip that provider.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Hugging Face Inference Providers (router) and GitHub Models.
HF_TOKEN=
GITHUB_MODELS_TOKEN=

# Model chains: provider:model references tried in order; a model whose daily budget is
# exhausted is skipped for the rest of the run. Defaults are in config.py.
ANSWER_CHAIN=
REFLECT_CHAIN=
JUDGE_CHAIN=
LLM_MAX_RETRIES=6

# Local embedding model. Runs on CPU, no API key needed.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# torch (sentence-transformers) locally; the Docker image sets onnx.
EMBEDDING_BACKEND=torch

# Qdrant. Local dev uses the docker-compose service on a project-specific port.
# For the live deploy, set QDRANT_URL to the Qdrant Cloud endpoint and supply the key.
QDRANT_URL=http://localhost:16333
QDRANT_API_KEY=
QDRANT_COLLECTION=quickcommerce_kb
# Set to a directory to run Qdrant embedded in-process (used by the Docker image).
QDRANT_PATH=

# Postgres backing the read-only MCP inventory/orders tools (phase 2).
POSTGRES_DSN=postgresql://darkstore:darkstore@localhost:55432/darkstore
# postgres for local dev; sqlite for the single-container deployment and tests.
TOOLS_BACKEND=postgres
SQLITE_PATH=data/darkstore.sqlite
# Maximum live tool calls per question before the agent must answer or refuse.
TOOL_CALL_CAP=3
# agentic (default) or retrieval for the classic baseline.
AGENT_MODE=agentic
AGENT_MAX_STEPS=6

# Where the generated catalog and policy documents live. Defaults to ./data.
DATA_DIR=

# Retrieval and generation tuning.
RETRIEVAL_TOP_K=5
CHUNK_TOKENS=220
CHUNK_OVERLAP_TOKENS=40


# Evaluation. The judge model scores RAGAS metrics; concurrency is kept low because
# the Groq free tier is rate limited.
EVAL_CONCURRENCY=2
EVAL_MAX_RETRIES=8
